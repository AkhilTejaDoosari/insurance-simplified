# Names only - copy to .env.local and fill in. Never commit values.
# LLM used by the web app: nvidia (other choice: --web-llm kodekey)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# KodeKey gateway (Claude). Documents sent here pass through KodeKloud.
KODEKEY_BASE_URL=
KODEKEY_API_KEY=
KODEKEY_MODEL=

# NVIDIA Nemotron 3 Ultra (build.nvidia.com free tier, 40 req/min).
# Development only: public test documents, no personal data.
NVIDIA_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Leave empty; this was only for the local qwen3 model.
LLM_REASONING_EFFORT=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

DATABASE_URL=
SUPABASE_DB_URL=

SUPABASE_STORAGE_BUCKET=

CLOUDFLARE_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

REAL_PDFS_DIR=
REAL_FIXTURES_DIR=
