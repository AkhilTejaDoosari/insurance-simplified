# Engine settings — names only, never commit values.
# development | test | production (default production)
ENGINE_ENV=
# Shared secret the web app sends as "Authorization: Bearer <token>" on /v1 routes.
ENGINE_SERVICE_TOKEN=
# DEBUG | INFO | WARNING (default INFO)
ENGINE_LOG_LEVEL=

# Cloud models (off unless every rule in app/recovery/policy.py holds).
# Providers this deployment may call, e.g. anthropic,openai
ENGINE_CLOUD_PROVIDERS=
# Providers whose data-retention terms were reviewed (the retention record),
# e.g. anthropic,kodekey,openai
ENGINE_CLOUD_RETENTION_REVIEWED=
# "approved" lets documents users upload go to the providers above (owner decision).
ENGINE_CLOUD_CUSTOMER_DOCUMENTS=
# Claude: reads unsettled pages, judges reader facts, writes plain-words lines.
ENGINE_ANTHROPIC_API_KEY=
ENGINE_ANTHROPIC_BASE_URL=
ENGINE_ANTHROPIC_MODEL=
# GPT: judges the facts Claude proposed (D-034 key 2; owner 2026-11-28: gpt-5.5 via KodeKey).
ENGINE_OPENAI_API_KEY=
ENGINE_OPENAI_BASE_URL=
ENGINE_OPENAI_MODEL=
# USD per million tokens; a provider without a price is never called under a cost cap.
ENGINE_PRICE_ANTHROPIC_IN=
ENGINE_PRICE_ANTHROPIC_OUT=
ENGINE_PRICE_OPENAI_IN=
ENGINE_PRICE_OPENAI_OUT=
# Per-document model cost cap in USD (at most 1.00; $1 is for testing only, D-036).
ENGINE_DOCUMENT_COST_CAP_USD=
# Cumulative Claude tokens across documents, and the ledger file that counts them
# (a cap without a ledger runs no Claude call; production path: WP12).
ENGINE_CLAUDE_TOKEN_CAP=
ENGINE_CLAUDE_TOKEN_LEDGER=
# Optional hard stop across documents and runs (testing): total model spend in USD, and
# the ledger file that counts it (a cap without a ledger runs no model call).
ENGINE_SPEND_CAP_USD=
ENGINE_SPEND_LEDGER=
# WP5 background jobs (python -m app.jobs.worker): the web app's base URL for its internal
# job API (https, or a local address in development); the same ENGINE_SERVICE_TOKEN is the
# worker's credential there. Seconds between polls when there is no job (default 3).
ENGINE_WEB_URL=
ENGINE_JOB_POLL_SECONDS=
